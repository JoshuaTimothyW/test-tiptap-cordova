<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.jtw.notes" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Notes</name>
    <description>Notes editor (Tiptap) dengan hot-update + share intent</description>
    <author email="you@example.com">JTW</author>

    <content src="index.html" />

    <access origin="*" />

    <!-- WAJIB: izinkan navigasi ke file lokal hasil extract bundle & ke host update -->
    <allow-navigation href="file:///*" />
    <allow-navigation href="https://github.com/*" />
    <allow-navigation href="content:///*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="MixedContentMode" value="0" />

    <!-- Jangan tampilkan splash screen (robot Cordova / logo default):
         langsung ke editor. Kalau plugin splashscreen kebetulan ikut terpasang,
         preferensi ini memaksanya menyembunyikan diri segera. -->
    <preference name="SplashScreen" value="none" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="FadeSplashScreen" value="false" />
    <preference name="BackgroundColor" value="0xFFFFFFFF" />
    <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />

    <!-- spec harus versi eksplisit (cordova tidak kenal "latest").
    Versi di bawah = hasil `npm view <pkg> version` (side-effects ini ada di npm),
    yang sama dengan yang dipakai scaffold kecuali webintent (maks 0.0.2
    di npm; ^3.0.0 yang di scaffold tidak pernah ada). -->
    <plugin name="cordova-plugin-webintent" spec="0.0.2" />
    <plugin name="cordova-plugin-file" spec="8.1.3" />
    <plugin name="cordova-plugin-file-transfer" spec="2.0.1" />
    <plugin name="cordova-plugin-whitelist" spec="1.3.5" />
    <plugin name="cordova-plugin-local-notification" spec="1.2.3" />

    <platform name="android">
        <preference name="AndroidLaunchMode" value="singleTask" />

        <!-- Share sheet: terima teks/link dari app lain -->
        <edit-config file="app/src/main/AndroidManifest.xml" target="/manifest/application/activity" mode="merge">
            <activity android:launchMode="singleTask">
                <intent-filter>
                    <action android:name="android.intent.action.SEND" />
                    <category android:name="android.intent.category.DEFAULT" />
                    <data android:mimeType="text/plain" />
                </intent-filter>
                <intent-filter>
                    <action android:name="android.intent.action.SEND" />
                    <category android:name="android.intent.category.DEFAULT" />
                    <data android:mimeType="text/*" />
                </intent-filter>
            </activity>
        </edit-config>

        <!-- Izin akses internet, storage & notifikasi (Android 13+) -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        </config-file>

        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
    </platform>
</widget>
